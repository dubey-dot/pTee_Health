# Comma-separated list of origins allowed to call this API (CORS).
# Local dev default already applies if this is unset.
ALLOWED_ORIGINS=http://localhost:3000

# Postgres connection string. Matches docker-compose.yml's default
# credentials/port (5433 on the host, to avoid clashing with any Postgres
# already running natively). Run `docker compose up -d` from backend/ first.
DATABASE_URL=postgresql+psycopg://ptee:ptee@localhost:5433/ptee_health

# Anthropic API key — powers real AI-generated working diagnosis/confidence/
# insights (POST /assessments/{id}/diagnosis/generate). Without it, that one
# endpoint returns a 502 when called; every other endpoint is unaffected.
# Real keys always start with "sk-ant-" (generate one at
# https://console.anthropic.com/settings/keys) — never commit a real value here.
ANTHROPIC_API_KEY=
